{
  "name": "monitor-cl",
  "version": "0.2.0",
  "description": "MONITOR CL - Monitor de Cotizaciones PanamaCompra",
  "main": "src/main.js",
  "author": "Monitor CL",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps && playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "pa.monitorcl.app",
    "productName": "Monitor CL",
    "artifactName": "MonitorCL_Setup.exe",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/playwright/**/*",
      "node_modules/playwright-core/**/*",
      "node_modules/.bin/playwright*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Monitor CL 👀"
    },
    "extraMetadata": {}
  }
}